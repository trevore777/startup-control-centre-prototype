<%- include('layout-top') %>
<h1>Expenses</h1>
<form method="post" class="panel form-grid">
  <label>Date <input type="date" name="expense_date" value="<%= today %>" required></label>
  <label>Supplier <input name="supplier" required></label>
  <label>Category <select name="category"><option>Hosting</option><option>AI/API</option><option>Database</option><option>Domain</option><option>Email</option><option>Software</option><option>Marketing</option><option>Equipment</option><option>Home Office</option><option>Professional Fees</option><option>Bank/Stripe Fees</option><option>Other</option></select></label>
  <label>Description <input name="description"></label>
  <label>Amount <input type="number" step="0.01" name="amount" required></label>
  <label>Business % <input type="number" step="1" name="business_percent" value="100"></label>
  <label>Paid from <input name="paid_from"></label>
  <label class="check"><input type="checkbox" name="gst_included"> GST included</label>
  <label class="check"><input type="checkbox" name="receipt_saved"> Receipt saved</label>
  <label class="full">Notes <textarea name="notes"></textarea></label>
  <button class="button">Add Expense</button>
</form>
<table><thead><tr><th>Date</th><th>Supplier</th><th>Category</th><th>Amount</th><th>Business %</th><th>Claimable</th><th>Receipt</th><th></th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><%= r.expense_date %></td><td><%= r.supplier %></td><td><%= r.category %></td><td><%= currency(r.amount) %></td><td><%= r.business_percent %>%</td><td><%= currency(r.amount*r.business_percent/100) %></td><td><%= r.receipt_saved?'Yes':'No' %></td><td><form method="post" action="/delete/expenses/<%= r.id %>"><button class="link danger">Delete</button></form></td></tr><% }) %>
</tbody></table>
<a class="button secondary" href="/export/expenses.csv">Export CSV</a>
<%- include('layout-bottom') %>
