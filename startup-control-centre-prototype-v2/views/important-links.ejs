<%- include('layout-top') %>

<h1>Important Links</h1>

<div class="panel">
  <h2>Add Link</h2>

  <form method="POST" action="/important-links">
    <label>Title</label>
    <input type="text" name="title" required>

    <label>URL</label>
    <input type="url" name="url" required>

    <label>Category</label>
    <input type="text" name="category">

    <label>Notes</label>
    <textarea name="notes"></textarea>

    <button type="submit">Add Link</button>
  </form>
</div>

<div class="panel">
  <h2>Saved Links</h2>

  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Open</th>
        <th>Delete</th>
      </tr>
    </thead>

    <tbody>
      <% rows.forEach(link => { %>
      <tr>
        <td><%= link.title %></td>
        <td><%= link.category %></td>

        <td>
          <a
            class="button"
            href="<%= link.url %>"
            target="_blank">
            Open
          </a>
        </td>

        <td>
          <form
            method="POST"
            action="/important-links/delete/<%= link.id %>">

            <button type="submit">
              Delete
            </button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>