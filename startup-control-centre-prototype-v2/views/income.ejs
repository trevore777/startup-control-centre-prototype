<%- include('layout-top') %>
<h1>Income</h1>
<form method="post" class="panel form-grid">
  <label>Date <input type="date" name="income_date" value="<%= today %>" required></label>
  <label>Customer <input name="customer" required></label>
  <label>Product/service <input name="product"></label>
  <label>Gross amount <input type="number" step="0.01" name="gross_amount" required></label>
  <label>Stripe/bank fee <input type="number" step="0.01" name="stripe_fee" value="0"></label>
  <label>Invoice ref <input name="invoice_ref"></label>
  <label class="full">Notes <textarea name="notes"></textarea></label>
  <button class="button">Add Income</button>
</form>
<table><thead><tr><th>Date</th><th>Customer</th><th>Product</th><th>Gross</th><th>Fee</th><th>Net</th><th></th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><%= r.income_date %></td><td><%= r.customer %></td><td><%= r.product %></td><td><%= currency(r.gross_amount) %></td><td><%= currency(r.stripe_fee) %></td><td><%= currency(r.gross_amount-r.stripe_fee) %></td><td><form method="post" action="/delete/income/<%= r.id %>"><button class="link danger">Delete</button></form></td></tr><% }) %>
</tbody></table>
<a class="button secondary" href="/export/income.csv">Export CSV</a>
<%- include('layout-bottom') %>
