<%- include('layout-top') %>
<h1>Founder Work Log</h1>
<p class="muted">Tracks your time investment. For a sole trader, this is usually not a tax deduction, but it helps value the project.</p>
<form method="post" class="panel form-grid">
  <label>Date <input type="date" name="work_date" value="<%= today %>" required></label>
  <label>Project <input name="project" value="Student Evidence App" required></label>
  <label>Task <input name="task" required></label>
  <label>Hours <input type="number" step="0.1" name="hours" required></label>
  <label>Hourly value <input type="number" step="1" name="hourly_value" value="60"></label>
  <label class="full">Notes <textarea name="notes"></textarea></label>
  <button class="button">Add Work Log</button>
</form>
<table><thead><tr><th>Date</th><th>Project</th><th>Task</th><th>Hours</th><th>Implied Value</th><th></th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><%= r.work_date %></td><td><%= r.project %></td><td><%= r.task %></td><td><%= r.hours %></td><td><%= currency(r.hours*r.hourly_value) %></td><td><form method="post" action="/delete/work_log/<%= r.id %>"><button class="link danger">Delete</button></form></td></tr><% }) %>
</tbody></table>
<a class="button secondary" href="/export/work_log.csv">Export CSV</a>
<%- include('layout-bottom') %>
